<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ASP.NET Core Web API (.NET 8). It serves the HTML/CSS/JS front end
       from wwwroot/ and answers the browser's /api/... calls by running
       stored procedures through ADO.NET. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ParkingWeb</RootNamespace>
    <AssemblyName>ParkingWeb</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

</Project>
